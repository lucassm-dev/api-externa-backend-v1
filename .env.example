# Banco de dados (PostgreSQL via Docker)
POSTGRES_DB=investimentos
POSTGRES_USER=investimentos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Chaves de API
BRAPI_TOKEN=seu-token-brapi
TWELVEDATA_API_KEY=sua-chave-twelvedata

# Segredo do JWT (SPEC-02) — gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-256-bits-ou-mais

# Docker Compose
# Onde está o repositório do frontend, para o compose construir a imagem dele.
FRONTEND_PATH=../../Angular/api-externa-frontend-v2
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Origens externas autorizadas a chamar a API. Vazio é o normal: o frontend
# conversa com a API pela mesma origem, através do nginx, e não gera
# requisição de outra origem. Preencha só para cliente externo.
CORS_ALLOWED_ORIGINS=
